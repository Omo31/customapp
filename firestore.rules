rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function hasRole(role) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (
               getUserData(request.auth.uid).roles.hasAny(['superadmin']) ||
               getUserData(request.auth.uid).roles.hasAny([role])
             ) &&
             getUserData(request.auth.uid).disabled != true;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // Admins can read/list all users. Users can read their own profile.
      allow read: if isOwner(userId) || hasRole('users');
      allow list: if hasRole('users');
      
      // Only admins can update roles. Users can update their own non-role fields.
      allow update: if hasRole('users') || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'disabled']));
      
      // Profile creation is usually handled by Cloud Functions, but allow the user to set their initial doc.
      allow create: if isOwner(userId);
      allow delete: if hasRole('users');

      match /notifications/{notificationId} {
        allow read, list: if isOwner(userId) || hasRole('users');
        allow create: if isOwner(userId) || hasRole('quotes') || hasRole('orders');
        allow update, delete: if isOwner(userId);
      }
    }

    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || hasRole('quotes'));
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if hasRole('quotes') || (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow list: if hasRole('quotes');
    }
    
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || hasRole('orders'));
      allow list: if hasRole('orders');
      allow write: if hasRole('orders');
    }
    
    match /purchaseOrders/{poId} {
      allow read, write: if hasRole('purchase-orders');
    }
    
    match /expenses/{expenseId} {
      allow read, write: if hasRole('accounting');
    }
    
    match /notifications/{notificationId} {
      allow read, list, update, delete: if hasRole('notifications') || (resource.data.role != null && hasRole(resource.data.role));
      allow create: if isAuthenticated();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasRole('settings');
    }
  }
}

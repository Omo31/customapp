
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---

    function getUserData(userId) {
      let uid = userId != null ? userId : request.auth.uid;
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function isNotDisabled() {
        // A user is not disabled if the 'disabled' field is not true.
        // This function should only be called after verifying the user document exists.
        return getUserData(request.auth.uid).disabled != true;
    }

    function userExists(userId) {
        let uid = userId != null ? userId : request.auth.uid;
        return exists(/databases/$(database)/documents/users/$(uid));
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      // User must be authenticated, their profile must exist, and they must have the 'superadmin' role.
      return request.auth != null &&
             userExists(request.auth.uid) &&
             'roles' in getUserData(request.auth.uid) &&
             'superadmin' in getUserData(request.auth.uid).roles;
    }

    function hasRole(role) {
        // Superadmin bypasses role checks OR the user has the specific role and is not disabled.
        return isSuperAdmin() || (
               request.auth != null &&
               userExists(request.auth.uid) &&
               'roles' in getUserData(request.auth.uid) && // Ensure roles exist
               getUserData(request.auth.uid).roles.hasAny([role]) &&
               isNotDisabled()
        );
    }
        
    function isQuoteOwner(quote) {
      return isOwner(quote.userId);
    }
    
    function isChangingStatusTo(status) {
      // Checks if the 'status' field is being changed to a specific value.
      return request.resource.data.status == status && resource.data.status != status;
    }

    // --- Collection Rules ---

    // Users Collection
    match /users/{userId} {
      // Admins with 'users' role can read any profile. A user can read their own profile.
      allow read: if hasRole('users') || isOwner(userId);
      
      // An owner can update their own profile, but cannot change their own roles.
      // An admin with the 'users' role can update any profile (including roles).
      allow update: if (isOwner(userId) && !('roles' in request.resource.data)) || hasRole('users');

      // A user can only create their own document. This is crucial for signup.
      allow create: if request.auth.uid == userId;
      
      allow delete: if hasRole('users');
      
      // CORRECTED RULE: An admin with the 'users' role OR a superadmin should be able to view the list of users.
      allow list: if hasRole('users');

      // User Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, list: if isOwner(userId);
        // An admin with 'quotes' or 'orders' role can create notifications for the user
        allow create: if isOwner(userId) || hasRole('quotes') || hasRole('orders');
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }

    // Quotes Collection
    match /quotes/{quoteId} {
      allow read: if isQuoteOwner(resource.data) || hasRole('quotes');
      allow update: if hasRole('quotes') || 
                      (isQuoteOwner(resource.data) && (
                          isChangingStatusTo('Quote Ready') ||
                          isChangingStatusTo('Rejected') ||
                          isChangingStatusTo('Cancelled')
                      ));
      // Any authenticated user can create a quote.
      allow create: if request.auth != null;
      allow list: if hasRole('quotes') || (request.auth != null && request.query.where[0] == 'userId' && request.query.where[2] == request.auth.uid && userExists(request.auth.uid) && isNotDisabled());
    }
    
    // Orders Collection
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || hasRole('orders');
      allow write, update: if hasRole('orders');
      allow create, delete: if false; 
      
      // Regular users can list their own orders. Admins with 'orders' role can list all orders.
      allow list: if hasRole('orders') || (request.auth != null && request.query.where[0] == 'userId' && request.query.where[2] == request.auth.uid && userExists(request.auth.uid) && isNotDisabled());
    }
    
    // Purchase Orders Collection (Admin-only)
    match /purchaseOrders/{poId} {
      allow read, write, create, list: if hasRole('purchase-orders');
    }
    
    // Expenses Collection (Admin-only)
    match /expenses/{expenseId} {
      allow read, write, create, list: if hasRole('accounting');
    }
    
    // Root Notifications Collection for Admins
    match /notifications/{notificationId} {
      // Any user with an admin role can see notifications for their roles.
      allow read, list: if request.auth != null && 
                          userExists(request.auth.uid) && 
                          getUserData(request.auth.uid).roles.size() > 1; 
      allow update, delete: if hasRole('notifications');
      // Any authenticated user can create a notification for admins (e.g., on signup).
      allow create: if request.auth != null;
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if hasRole('settings');
    }
  }
}
